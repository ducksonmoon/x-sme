# Production Environment Configuration
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://x_sme_user:x_sme_password@postgres:5432/x_sme_db?schema=public

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random-at-least-32-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-key-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
ALLOWED_ORIGINS=https://x-sme.ir,https://www.x-sme.ir

VITE_API_URL=https://193.36.84.222

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Payment Gateway Configuration

# Pasargad Bank
PASARGAD_MERCHANT_ID=your-pasargad-merchant-id
PASARGAD_TERMINAL_ID=your-pasargad-terminal-id
PASARGAD_PRIVATE_KEY_PATH=./keys/pasargad-private-key.pem
PASARGAD_CALLBACK_URL=https://x-sme.ir/api/payments/pasargad/callback

# Saman Bank
SAMAN_MERCHANT_ID=your-saman-merchant-id
SAMAN_CALLBACK_URL=https://x-sme.ir/api/payments/saman/callback

# Zarinpal
ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id
ZARINPAL_CALLBACK_URL=https://x-sme.ir/api/payments/zarinpal/callback
ZARINPAL_SANDBOX=false

# SMS Service Configuration
SMS_PROVIDER=melipayamak
MELIPAYAMAK_USERNAME=your-melipayamak-username
MELIPAYAMAK_PASSWORD=your-melipayamak-password
MELIPAYAMAK_FROM_NUMBER=your-sender-number

# Alternative SMS providers
KAVENEGAR_API_KEY=your-kavenegar-api-key
GHASEDAK_API_KEY=your-ghasedak-api-key

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://x-sme.ir/api/telegram/webhook

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@x-sme.ir

# Redis Configuration
REDIS_URL=redis://:redis_password@redis:6379
REDIS_PASSWORD=redis_password

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif
UPLOAD_PATH=./uploads

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=5242880
LOG_MAX_FILES=5

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key-at-least-32-characters
COOKIE_SECRET=your-cookie-secret-key-at-least-32-characters

# Business Configuration
DEFAULT_TIMEZONE=Asia/Tehran
DEFAULT_DEPOSIT_PERCENTAGE=10
DEFAULT_CANCELLATION_POLICY=24h
DEFAULT_REMINDER_TIME=60

# Monitoring and Analytics
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=your-ga-id

# External APIs
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
WEATHER_API_KEY=your-weather-api-key

# Production Configuration
DEBUG=false
ENABLE_SWAGGER=false
ENABLE_GRAPHIQL=false
ENABLE_COMPRESSION=true
ENABLE_CACHE=true
CACHE_TTL=3600

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=300000
HEALTH_CHECK_TIMEOUT=5000 