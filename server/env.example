# Application Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/x_sme_db?schema=public"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Payment Gateway Configuration

# Pasargad Bank
PASARGAD_MERCHANT_ID=your-pasargad-merchant-id
PASARGAD_TERMINAL_ID=your-pasargad-terminal-id
PASARGAD_PRIVATE_KEY_PATH=./keys/pasargad-private-key.pem
PASARGAD_CALLBACK_URL=https://your-domain.com/api/payments/pasargad/callback

# Saman Bank
SAMAN_MERCHANT_ID=your-saman-merchant-id
SAMAN_CALLBACK_URL=https://your-domain.com/api/payments/saman/callback

# Zarinpal
ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id
ZARINPAL_CALLBACK_URL=https://your-domain.com/api/payments/zarinpal/callback
ZARINPAL_SANDBOX=true

# SMS Service Configuration
SMS_PROVIDER=melipayamak
MELIPAYAMAK_USERNAME=your-melipayamak-username
MELIPAYAMAK_PASSWORD=your-melipayamak-password
MELIPAYAMAK_FROM_NUMBER=your-sender-number

# Alternative SMS providers
KAVENEGAR_API_KEY=your-kavenegar-api-key
GHASEDAK_API_KEY=your-ghasedak-api-key

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@your-domain.com

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif
UPLOAD_PATH=./uploads

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=5242880
LOG_MAX_FILES=5

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key
COOKIE_SECRET=your-cookie-secret-key

# Business Configuration
DEFAULT_TIMEZONE=Asia/Tehran
DEFAULT_DEPOSIT_PERCENTAGE=10
DEFAULT_CANCELLATION_POLICY=24h
DEFAULT_REMINDER_TIME=60

# Monitoring and Analytics
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=your-ga-id

# External APIs
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
WEATHER_API_KEY=your-weather-api-key

# Development Configuration
DEBUG=true
ENABLE_SWAGGER=true
ENABLE_GRAPHIQL=true

# Production Configuration
ENABLE_COMPRESSION=true
ENABLE_CACHE=true
CACHE_TTL=3600

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=300000
HEALTH_CHECK_TIMEOUT=5000 