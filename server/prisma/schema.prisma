generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  firstName     String?
  lastName      String?
  phone         String?
  role          UserRole       @default(BUSINESS_OWNER)
  businessId    String?
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  staff         staff?
  subscriptions Subscription[]
  business      Business?      @relation(fields: [businessId], references: [id])
  notifications Notification[]

  @@map("users")
}

model Business {
  id           String            @id @default(cuid())
  name         String
  description  String?
  phone        String
  email        String
  address      String?
  website      String?
  logo         String?
  theme        String            @default("light")
  timezone     String            @default("Asia/Tehran")
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  billingInfo  BillingInfo?
  bookings     Booking[]
  settings     BusinessSettings?
  holidays     Holiday[]
  services     Service[]
  staff        staff[]
  subscription Subscription?
  subscriptionPayments SubscriptionPayment[]
  usageStats   UsageStats[]
  users        User[]
  workingHours WorkingHour[]
  domains      Domain[]          // New: Custom domains

  @@map("businesses")
}

model BusinessSettings {
  id                   String   @id @default(cuid())
  businessId           String   @unique
  depositRequired      Boolean  @default(false)
  depositPercentage    Int      @default(0)
  paymentRequired      Boolean  @default(false)
  paymentGateways      Json?
  currency             String   @default("toman")
  cancellationPolicy   String   @default("24h")
  reminderTime         Int      @default(60)
  smsEnabled           Boolean  @default(true)
  telegramEnabled      Boolean  @default(false)
  telegramBotToken     String?
  telegramChatId       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  advanceBookingDays   Int      @default(30)
  bufferBetweenSlots   Int      @default(15)
  includeLunchBreak    Boolean  @default(true)
  lunchBreakEnd        String   @default("13:00")
  lunchBreakStart      String   @default("12:00")
  maxBookingsPerSlot   Int      @default(1)
  maxSlotsPerDay       Int      @default(20)
  optimizeForPeakHours Boolean  @default(true)
  peakHoursEnd         String   @default("16:00")
  peakHoursStart       String   @default("10:00")
  respectWorkingHours  Boolean  @default(true)
  sameDayBooking       Boolean  @default(true)
  useServiceDuration   Boolean  @default(true)
  widgetConfig         Json?
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

model Service {
  id             String           @id @default(cuid())
  businessId     String
  name           String
  description    String?
  duration       Int
  price          Decimal          @db.Decimal(10, 2)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  TimeSlot       TimeSlot[]
  bookings       Booking[]
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff_services staff_services[]

  @@map("services")
}

model WorkingHour {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@map("working_hours")
}

model Holiday {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime @db.Date
  reason     String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@map("holidays")
}

model Booking {
  id            String        @id @default(cuid())
  businessId    String
  serviceId     String
  customerName  String
  customerPhone String
  customerEmail String?
  date          DateTime      @db.Date
  startTime     String
  endTime       String
  status        BookingStatus @default(PENDING)
  totalAmount   Decimal       @db.Decimal(10, 2)
  depositAmount Decimal?      @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  staffId       String?
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service       Service       @relation(fields: [serviceId], references: [id])
  staff         staff?        @relation(fields: [staffId], references: [id])
  payments      Payment[]
  reminders     Reminder[]

  @@map("bookings")
}

model Payment {
  id            String         @id @default(cuid())
  bookingId     String
  amount        Decimal        @db.Decimal(10, 2)
  gateway       PaymentGateway
  gatewayRef    String?
  status        PaymentStatus  @default(PENDING)
  transactionId String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Reminder {
  id          String          @id @default(cuid())
  bookingId   String
  type        ReminderType
  channel     ReminderChannel
  status      ReminderStatus  @default(PENDING)
  scheduledAt DateTime
  sentAt      DateTime?
  error       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model TimeSlot {
  id          String   @id @default(cuid())
  serviceId   String
  date        DateTime
  startTime   String
  endTime     String
  isBooked    Boolean  @default(false)
  capacity    Int      @default(0)
  maxCapacity Int      @default(1)
  isPeakHour  Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  services    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, date, startTime])
  @@index([date, isBooked])
  @@index([serviceId, date])
  @@index([serviceId, date, startTime])
  @@index([serviceId, isBooked])
}

model Plan {
  id             String         @id @default(cuid())
  name           String         @unique
  nameEn         String?
  description    String
  setupFee       Decimal        @db.Decimal(10, 2)
  monthlyFee     Decimal        @db.Decimal(10, 2)
  yearlyFee      Decimal?       @db.Decimal(10, 2)
  commissionRate Float          @default(0)
  bookingsLimit  Int?
  servicesLimit  Int?
  smsLimit       Int?
  features       Json
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subscriptions  Subscription[]
  currentPayments SubscriptionPayment[] @relation("CurrentPlan")
  newPayments     SubscriptionPayment[] @relation("NewPlan")

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  businessId         String             @unique
  userId             String
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  billingCycle       BillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialStart         DateTime?
  trialEnd           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  invoices           Invoice[]
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])
  user               User               @relation(fields: [userId], references: [id])
  usageStats         UsageStats[]

  @@map("subscriptions")
}

model Invoice {
  id             String           @id @default(cuid())
  subscriptionId String
  number         String           @unique
  amount         Decimal          @db.Decimal(10, 2)
  setupFee       Decimal?         @db.Decimal(10, 2)
  monthlyFee     Decimal?         @db.Decimal(10, 2)
  commissionFee  Decimal?         @db.Decimal(10, 2)
  discountAmount Decimal?         @db.Decimal(10, 2)
  taxAmount      Decimal?         @db.Decimal(10, 2)
  totalAmount    Decimal          @db.Decimal(10, 2)
  currency       String           @default("IRR")
  status         InvoiceStatus    @default(PENDING)
  dueDate        DateTime
  paidAt         DateTime?
  description    String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  payments       InvoicePayment[]
  subscription   Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model InvoicePayment {
  id            String         @id @default(cuid())
  invoiceId     String
  amount        Decimal        @db.Decimal(10, 2)
  gateway       PaymentGateway
  gatewayRef    String?
  status        PaymentStatus  @default(PENDING)
  transactionId String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_payments")
}

model SubscriptionPayment {
  id              String         @id @default(cuid())
  businessId      String
  currentPlanId   String
  newPlanId       String
  billingCycle    BillingCycle
  amount          Decimal        @db.Decimal(10, 2)
  gateway         PaymentGateway
  gatewayRef      String?
  status          PaymentStatus  @default(PENDING)
  paidAt          DateTime?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currentPlan     Plan           @relation("CurrentPlan", fields: [currentPlanId], references: [id])
  newPlan         Plan           @relation("NewPlan", fields: [newPlanId], references: [id])

  @@map("subscription_payments")
}

model UsageStats {
  id             String       @id @default(cuid())
  businessId     String
  subscriptionId String
  month          Int
  year           Int
  bookingsCount  Int          @default(0)
  smsCount       Int          @default(0)
  revenueAmount  Decimal      @default(0) @db.Decimal(10, 2)
  commissionOwed Decimal      @default(0) @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([businessId, subscriptionId, month, year])
  @@map("usage_stats")
}

model BillingInfo {
  id            String   @id @default(cuid())
  businessId    String   @unique
  companyName   String?
  taxId         String?
  address       String?
  city          String?
  postalCode    String?
  phone         String?
  email         String?
  bankAccount   String?
  bankName      String?
  accountHolder String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("billing_info")
}

model staff {
  id                  String                @id @default(cuid())
  businessId          String
  firstName           String
  lastName            String
  email               String?
  phone               String?
  avatar              String?
  bio                 String?
  specialization      String?
  experience          String?
  isActive            Boolean               @default(true)
  canLogin            Boolean               @default(false)
  userId              String?               @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime @updatedAt
  bookings            Booking[]
  businesses          Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users               User?                 @relation(fields: [userId], references: [id])
  staff_breaks        staff_breaks[]
  staff_services      staff_services[]
  staff_time_off      staff_time_off[]
  staff_working_hours staff_working_hours[]
  staff_permissions   StaffPermission[]     // NEW: Staff permissions
}

model staff_breaks {
  id        String   @id @default(cuid())
  staffId   String
  title     String   @default("Break")
  startTime String
  endTime   String
  dayOfWeek Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff     staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model staff_services {
  id          String   @id @default(cuid())
  staffId     String
  serviceId   String
  customPrice Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  services    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff       staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
}

model staff_time_off {
  id        String      @id @default(cuid())
  staffId   String
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  reason    String?
  type      TimeOffType @default(VACATION)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime @updatedAt
  staff     staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model staff_working_hours {
  id        String   @id @default(cuid())
  staffId   String
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff     staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
}

model StaffPermission {
  id          String           @id @default(cuid())
  staffId     String
  page        String           // e.g., "bookings", "services", "analytics", "settings"
  action      PermissionAction // e.g., "view", "edit", "delete", "create"
  isGranted   Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  staff       staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, page, action])
  @@map("staff_permissions")
}

model Domain {
  id          String        @id @default(cuid())
  businessId  String
  domain      String        @unique // e.g., "booking.mybusiness.com"
  type        DomainType    @default(CUSTOM)
  status      DomainStatus  @default(PENDING)
  sslStatus   SSLStatus     @default(PENDING)
  verifiedAt  DateTime?
  expiresAt   DateTime?
  dnsRecords  Json?         // Store DNS verification records
  metadata    Json?         // Additional domain info
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("domains")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // booking, payment, system, reminder
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      Json?    // Additional data for the notification
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum UserRole {
  ADMIN
  BUSINESS_OWNER
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentGateway {
  TEST
  PASARGAD
  SAMAN
  ZARINPAL
}

enum ReminderType {
  CONFIRMATION
  REMINDER
  CANCELLATION
}

enum ReminderChannel {
  SMS
  TELEGRAM
  EMAIL
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum TimeOffType {
  VACATION
  SICK_LEAVE
  PERSONAL
  HOLIDAY
  TRAINING
  OTHER
}

enum DomainType {
  CUSTOM      // Custom domain (e.g., booking.mybusiness.com)
  SUBDOMAIN   // Subdomain of main platform (e.g., mybusiness.x-sme.ir)
}

enum DomainStatus {
  PENDING     // Domain added, waiting for verification
  VERIFIED    // Domain ownership verified
  ACTIVE      // Domain is active and serving content
  FAILED      // Verification failed
  EXPIRED     // Domain expired
  SUSPENDED   // Domain suspended
}

enum SSLStatus {
  PENDING     // SSL certificate pending
  ACTIVE      // SSL certificate active
  FAILED      // SSL certificate failed
  EXPIRED     // SSL certificate expired
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  MANAGE
}
